# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Next.js (site/)
/site/node_modules/
/site/.next/
/site/.vercel/
/site/out/

# Supabase local temp files
/supabase/.temp/

# Environment files
.env
.env.*
*.env
.vercel
.env*.local

# Local audit dumps / scratch (never commit)
.tmp-*
.tmp/

# Preview bootstrap metadata pulled from remote (schema introspection only)
supabase/preview-bootstrap/_meta_*.json
supabase/preview-bootstrap/_raw_*

# Production cutover dumps (never commit)
/backups/


# local zeno preview secrets
supabase/functions/.env.zeno.preview.local

# local smoke/tmp artifacts
tmp-*.txt
tmp-*.json
tmp-*.log
